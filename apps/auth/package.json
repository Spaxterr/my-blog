{
    "name": "auth",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": ">=26.1.0"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "migrate": "pnpm dlx @better-auth/cli@latest migrate -y -c src/auth.config.ts",
        "lint": "biome check",
        "format": "biome check --write",
        "lint:staged": "biome check --staged --no-errors-on-unmatched",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@better-auth/redis-storage": "^1.7.3",
        "@hono/node-server": "^2.1.1",
        "better-auth": "^1.7.3",
        "dotenv": "^17.4.2",
        "hono": "^4.13.7",
        "ioredis": "^6.0.0",
        "pg": "^8.23.0",
        "pino": "^10.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/pg": "^8.23.1",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2"
    }
}
