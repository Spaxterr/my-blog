{
    "name": "blog-posts",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "cargo run",
        "build": "RUSTFLAGS=\"-C target-cpu=native\" cargo build --release",
        "test": "cargo test",
        "lint": "cargo clippy",
        "lint:staged": "git diff --cached --name-only --relative -- '*.rs' Cargo.toml | grep -q . && cargo clippy || true",
        "format": "cargo clippy --fix --allow-dirty"
    }
}
