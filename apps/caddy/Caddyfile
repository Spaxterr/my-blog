{
	email {$ACME_EMAIL:admin@example.com}
    order rate_limit before basicauth
}

import snippets/*.caddy

{$DOMAIN_NAME} {
	import headers
    import tarpit
    import qwik_optimizations

	# Qwik emits content-hashed filenames under these two paths only.
	@immutable path /build/* /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle /api/auth/* {
		reverse_proxy auth:3001
	}

	handle_path /api/blog/* {
		reverse_proxy blog-posts:3000
	}

	handle {
		reverse_proxy web:3004
	}
}
