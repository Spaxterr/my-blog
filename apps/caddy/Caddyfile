{
    order rate_limit before basicauth
	servers {
		# Only the server's own Caddy can reach the socket; it sets CF-Connecting-IP.
		trusted_proxies_unix
		client_ip_headers CF-Connecting-IP
	}
}

import snippets/*.caddy

http://{$DOMAIN_NAME} {
	bind unix//run/my-blog/caddy.sock|0666
	import security_and_compression
	import tarpit_config
	import qwik_optimizations

	handle /api/auth/* {
		reverse_proxy auth:3001 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle_path /api/blog/* {
		reverse_proxy blog-posts:3000
	}

	handle {
		reverse_proxy web:3004
	}
}
