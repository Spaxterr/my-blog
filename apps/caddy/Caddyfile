{
	email {$ACME_EMAIL:admin@example.com}
    order rate_limit before basicauth
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
	}
}

import snippets/*.caddy

{$DOMAIN_NAME} {
	import security_and_compression
	import tarpit_config
	import qwik_optimizations

	handle /api/auth/* {
		reverse_proxy auth:3001 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle_path /api/blog/* {
		reverse_proxy blog-posts:3000
	}

	handle {
		reverse_proxy web:3004
	}
}
