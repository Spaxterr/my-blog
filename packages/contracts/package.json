{
    "name": "@shared/contracts",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "tsp compile main.tsp --emit=@typespec/openapi3 --option @typespec/openapi3.file-type=json && pnpm generate:ts && pnpm generate:rs",
        "generate:ts": "openapi-generator-cli generate -i ./tsp-output/@typespec/openapi3/openapi.json -g typescript-fetch -o ./typescript/ --additional-properties=typescriptThreePlus=true",
        "generate:rs": "openapi-generator-cli generate -i ./tsp-output/@typespec/openapi3/openapi.json -g rust -o ./rust/ --global-property modelDocs=false,apiDocs=false --additional-properties=packageName=blog-contracts"
    },
    "exports": {
        ".": "./typescript/index.ts"
    },
    "dependencies": {
        "@typespec/compiler": "^1.15.0",
        "@typespec/http": "^1.15.0",
        "@typespec/openapi3": "^1.15.0",
        "@openapitools/openapi-generator-cli": "^2.40.1"
    }
}
