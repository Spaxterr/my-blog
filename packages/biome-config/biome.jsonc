{
    "root": false,
    "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git"
    },
    "files": {
        "includes": ["**", "!.turbo", "!**/.turbo", "!node_modules", "!**/node_modules", "!dist", "!**/dist"]
    },
    "formatter": {
        "enabled": true,
        "lineWidth": 110,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "domains": {
            "turborepo": "recommended",
            "types": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnusedVariables": "error"
            },
            "style": {
                "useTemplate": "error",
                "useNodejsImportProtocol": "error",
                "useImportType": "error",
                "useExportType": "error"
            },
            "suspicious": {
                "noExplicitAny": "warn"
            },
            "complexity": {
                "noForEach": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "all",
            "quoteStyle": "single",
            "semicolons": "always",
            "bracketSpacing": true,
            "quoteProperties": "asNeeded",
            "jsxQuoteStyle": "double",
            "bracketSameLine": false,
            "arrowParentheses": "always"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
