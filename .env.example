# Public origins, as a browser sees them. Locally use 127.0.0.1, not localhost —
# Swarm publishes IPv4 only. AUTH_ORIGIN must match the OAuth callback URLs.
AUTH_ORIGIN=https://auth.example.com
WEB_ORIGIN=https://example.com

# Image source
IMAGE_PREFIX=my-blog
RESOLVE_IMAGE=never
PUSH=0

# Published ports
WEB_PORT=80
AUTH_PORT=3001

REPLICAS=2
LOG_LEVEL=info

# Defaults to the current commit SHA. Set to deploy or roll back a specific build.
# TAG=
