{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "globalEnv": ["BASE_URL"],
    "globalPassThroughEnv": ["PORT", "AUTH_HOST", "AUTH_INTERNAL_HOST", "BLOG_POSTS_HOST"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "lint:staged": {
            "cache": false
        },
        "format": {
            "dependsOn": ["^format"]
        },
        "test": {
            "dependsOn": ["^test"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
